# Copy to .env (repo root) and fill in. Never commit the real .env file.
# Read by the backend (app/core/config.py) and by docker-compose.yml.

# --- Auth (REQUIRED) ---
# The server refuses to start without a random secret of at least 32 characters. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Web app address and outgoing email (password reset links) ---
# Reset links point here: the address where users open the web app.
PUBLIC_APP_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
# console: emails are written to the server log (local development only: anyone who can read
# the log can use the links). smtp: sent through your SMTP provider.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# e.g. LEARNABLE <no-reply@yourdomain.com>
SMTP_FROM=
SMTP_STARTTLS=true

# --- Self-hosting on a VM with your own domain (docs/DEPLOYMENT_ORACLE.md) ---
# COMPOSE_FILE=docker-compose.yml:deploy/oracle/docker-compose.oracle.yml
# DOMAIN=learnable.example.com

# --- Database ---
# Leave unset for local development: defaults to a SQLite file at backend/dev.db.
# For Postgres (any of postgresql://, postgres://, postgresql+psycopg:// works):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/adaptive_learning
# (docker-compose.yml sets its own DATABASE_URL for the containerized backend.)

# --- Runtime AI provider (see docs/AI.md §3) ---
# Provider is fully swappable — do not hard-code assumptions about which one is set.
# Empty: AI features off (the server runs; AI endpoints answer 503).
# mock: deterministic fake answers, no key needed (local development).
# router: per-operation free routes over several providers (docs/FREE_AI_ROUTING.md; keys below).
# groq, mistral, gemini, openrouter, nvidia, cloudflare, cohere: one provider, catalog endpoint
# (AI_BASE_URL optional; cloudflare also needs AI_CLOUDFLARE_ACCOUNT_ID). AI_MODEL required.
# openai_compatible, qwen, deepseek, kimi, glm: any OpenAI-compatible /chat/completions API;
# the name is only recorded as the provider. AI_BASE_URL and AI_MODEL are then required.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=60
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=8192
# Ask for JSON output (response_format). Set false if the endpoint rejects the parameter.
AI_JSON_MODE=true
# Most source text sent per AI call (~4 characters per token).
AI_MAX_CONTEXT_CHARS=60000

# Optional per-operation models (see AI.md §4) — leave blank to use AI_MODEL for everything
AI_MODEL_EXTRACTION=
AI_MODEL_GENERATION=
AI_MODEL_EVALUATION=
AI_MODEL_EXAM=

# Fallback providers, tried in order when the one before is down or keeps answering invalid
# output (AI.md §3). Use a different vendor from the primary. Each needs its own URL/key/model.
# They receive the same study material, so only configure vendors you accept for your data.
AI_FALLBACK1_PROVIDER=
AI_FALLBACK1_BASE_URL=
AI_FALLBACK1_API_KEY=
AI_FALLBACK1_MODEL=
AI_FALLBACK2_PROVIDER=
AI_FALLBACK2_BASE_URL=
AI_FALLBACK2_API_KEY=
AI_FALLBACK2_MODEL=

# --- Cost, data and routing policy (docs/FREE_AI_ROUTING.md) ---
# FREE_ONLY (default): only models marked free-only eligible ever run; a paid endpoint is never
# called. FREE_FIRST: free ones first, then others. ANY_CONFIGURED: route order as written.
AI_COST_POLICY=FREE_ONLY
# development | private. private: only models approved for private material (below) run.
AI_DATA_POLICY=development
# Comma-separated provider:model lists, e.g. nvidia:vendor/model after verifying "Free Endpoint".
AI_FREE_MODELS=
AI_PRIVATE_APPROVED_MODELS=
AI_EVALUATION_APPROVED_MODELS=
AI_EVALUATION_REQUIRE_APPROVED=false
# AI_PROVIDER=router: ordered provider:model candidates per operation; blank = catalog defaults.
AI_ROUTE_CURRICULUM_GENERATION=
AI_ROUTE_CONCEPT_EXTRACTION=
AI_ROUTE_LEARNING_ITEM_GENERATION=
AI_ROUTE_QUESTION_GENERATION=
AI_ROUTE_ANSWER_EVALUATION=
# Router credentials (leave blank to skip a provider). Never commit values.
AI_GROQ_API_KEY=
AI_MISTRAL_API_KEY=
AI_GEMINI_API_KEY=
AI_OPENROUTER_API_KEY=
AI_NVIDIA_API_KEY=
AI_CLOUDFLARE_API_TOKEN=
AI_CLOUDFLARE_ACCOUNT_ID=
AI_COHERE_API_KEY=
# Chinese model ecosystems via gateways (docs/FREE_AI_ROUTING.md §2b)
AI_ALIBABA_MODEL_STUDIO_API_KEY=
AI_ALIBABA_WORKSPACE_ID=
# true ONLY after enabling "Free Quota Only" in Model Studio (else its models stay out of FREE_ONLY)
AI_ALIBABA_FREE_ONLY_CONFIRMED=false
AI_TENCENT_TOKENHUB_API_KEY=
# true ONLY after disabling post-paid billing in TokenHub
AI_TENCENT_FREE_ONLY_CONFIRMED=false
AI_SILICONFLOW_API_KEY=
# Direct vendor APIs: paid, not needed for FREE_ONLY
AI_DEEPSEEK_API_KEY=
AI_MOONSHOT_API_KEY=
AI_ZAI_API_KEY=
AI_MINIMAX_API_KEY=

# --- Knowledge Repository storage (uploaded originals; docs/DEPLOYMENT.md §3) ---
# local: files under STORAGE_LOCAL_DIR (default: backend/var/documents). Durable across
#   redeploys only on a persistent volume (docker-compose.yml mounts one).
# s3: a PRIVATE bucket on any S3-compatible service (AWS S3, Cloudflare R2, Backblaze B2,
#   MinIO). Files are only served through the API after an ownership check.
STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=
# s3 only. Leave STORAGE_ENDPOINT empty for AWS S3 itself.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PREFIX=
MAX_UPLOAD_MB=50

# --- Background job recovery ---
# Jobs left PROCESSING/GENERATING for 15+ minutes (a restart killed them) are marked FAILED at
# startup and then every this many seconds. 0 disables the sweep.
JOB_RECOVERY_INTERVAL_SECONDS=60

# --- Logging ---
# DEBUG, INFO, WARNING, ERROR or CRITICAL. Applies to the app's own loggers.
LOG_LEVEL=INFO
